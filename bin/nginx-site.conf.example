# XIU Library — nginx konfiguratsiyasi (v3 uchun)
# =============================================================================
# XIU serveridagi holat: gunicorn unix-socket orqali (/run/library.sock),
# HTTPS esa oldindagi proxy'da (Nginx Proxy Manager) tugaydi.
#
# O'rnatish:
#   sudo cp bin/nginx-site.conf.example /etc/nginx/sites-available/library.xiuedu.uz
#   sudo nginx -t && sudo systemctl reload nginx
#
# v3 da uchta o'zgarish bor — pastda "O'ZGARDI" deb belgilangan.
# =============================================================================

# Oldindagi proxy yuborgan protokolni aniqlaydi:
#   · proxy X-Forwarded-Proto yuborsa  -> o'shani ishlatamiz (https)
#   · yubormasa                        -> shu nginx'ning o'z sxemasi (http)
#
# DIQQAT: `map` server blokidan TASHQARIDA turishi shart (http konteksti).
map $http_x_forwarded_proto $xiu_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name library.xiuedu.uz;

    # O'ZGARDI (1): katta ebook/audio yuklash uchun.
    # nginx standarti — atigi 1 MB; busiz 10 MB lik PDF "413" xatosi beradi.
    client_max_body_size 200M;

    location = /favicon.ico { access_log off; log_not_found off; }

    # O'ZGARDI (2): collectstatic endi `staticfiles/` papkasiga yig'adi.
    # Ilgari `root` bilan `static/` berilardi; endi `alias` + `staticfiles/`.
    location /static/ {
        alias /home/ubuntu/projects/library.xiuedu.uz/staticfiles/;
        expires 30d;
        access_log off;
    }

    # Ommaviy media: muqovalar, profil rasmlari (o'zgarmadi)
    location /media/ {
        root /home/ubuntu/projects/library.xiuedu.uz;
    }

    # O'ZGARDI (3): himoyalangan raqamli kitoblar.
    # `internal` — bu manzilni brauzerdan to'g'ridan-to'g'ri ochib bo'lmaydi;
    # faylni faqat Django ruxsat bergandan keyin (X-Accel-Redirect) nginx beradi.
    # BU BLOK BO'LMASA onlayn o'qish va audio tinglash ISHLAMAYDI.
    location /protected-media/ {
        internal;
        alias /home/ubuntu/projects/library.xiuedu.uz/media/;
    }

    location / {
        proxy_pass http://unix:/run/library.sock;

        # MUHIM: `include proxy_params;` ATAYLAB ishlatilmayapti.
        # U X-Forwarded-Proto ni $scheme ("http") bilan o'rnatadi; ustiga yana
        # bitta qo'shsak, nginx sarlavhani IKKI MARTA yuboradi va gunicorn
        # bunday so'rovni "400 Bad Request" bilan rad etadi.
        # Shuning uchun sarlavhalar shu yerda bir martadan yoziladi.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $xiu_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_redirect off;
        proxy_read_timeout 60s;
    }
}

# =============================================================================
# HTTPS
# -----------------------------------------------------------------------------
# Sertifikat oldindagi proxy'da bo'lsa, bu yerda 443 bloki shart emas —
# yuqoridagi `map` + `X-Forwarded-Proto` yetarli. Shundan keyin `.env` dagi
# `USE_HTTPS=0` ni olib tashlang: Django so'rov https ekanini ko'radi,
# cookie'lar `Secure` bo'ladi va ortiqcha yo'naltirish bo'lmaydi.
#
#   sudo sed -i '/^USE_HTTPS=0$/d' .env && sudo systemctl restart library
#
# Tekshirish — 200 qaytarishi kerak (301 emas):
#   curl -I -H "Host: library.xiuedu.uz" -H "X-Forwarded-Proto: https" http://127.0.0.1/
#
# Sertifikat to'g'ridan-to'g'ri shu nginx'da kerak bo'lsa:
#   sudo certbot --nginx -d library.xiuedu.uz
#
# ESLATMA: nginx `www-data` nomidan ishlaydi va statik fayllarni o'qishi uchun
# uy papkasiga kirish huquqi kerak. "403 Forbidden" chiqsa:
#   chmod o+x /home/ubuntu /home/ubuntu/projects
# =============================================================================
