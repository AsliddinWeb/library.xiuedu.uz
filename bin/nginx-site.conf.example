# XIU Library — nginx konfiguratsiyasi namunasi
# =============================================================================
# Serverda boshqa loyihalar ham bo'lsa, `bin/server-setup.sh` mavjud
# konfiguratsiyaga tegmaydi. Shu faylni namuna sifatida ishlatib, o'zingizning
# /etc/nginx/sites-available/library.xiuedu.uz faylingizni yangilang.
#
# v3 dan keyin IKKI narsa o'zgardi:
#   1. /static/  ->  staticfiles/   (ilgari static/ bo'lishi mumkin edi)
#   2. /protected-media/ — raqamli kitoblar himoyasi uchun SHART
#
# Yo'llarni o'z serveringizga moslang: /home/ubuntu/projects/library.xiuedu.uz
# =============================================================================

server {
    listen 80;
    server_name library.xiuedu.uz www.library.xiuedu.uz;

    # Katta ebook/audio fayllarni yuklash uchun
    client_max_body_size 200M;

    # --- Statik fayllar ---------------------------------------------------
    # MUHIM: collectstatic natijasi `staticfiles/` papkasiga tushadi.
    # Agar bu yerda `static/` yozilgan bo'lsa, sayt eski CSS bilan qoladi.
    location /static/ {
        alias /home/ubuntu/projects/library.xiuedu.uz/staticfiles/;
        expires 30d;
        access_log off;
    }

    # --- Ommaviy media (muqovalar, profil rasmlari) ------------------------
    location /media/ {
        alias /home/ubuntu/projects/library.xiuedu.uz/media/;
    }

    # --- Himoyalangan raqamli kitoblar ------------------------------------
    # `internal` — bu manzilni brauzerdan to'g'ridan-to'g'ri ochib bo'lmaydi.
    # Django ruxsat bergandagina (X-Accel-Redirect) nginx faylni beradi.
    # Bu blok bo'lmasa, PDF/audio stream ishlamaydi.
    location /protected-media/ {
        internal;
        alias /home/ubuntu/projects/library.xiuedu.uz/media/;
    }

    # --- Django (gunicorn) -------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# HTTPS ni certbot o'zi qo'shadi:
#   sudo certbot --nginx -d library.xiuedu.uz -d www.library.xiuedu.uz
